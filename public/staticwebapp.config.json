{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/catalog/*", "/images/*", "/fonts/*", "/icons/*"]
  },
  "routes": [
    { "route": "/index.html", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/sw.js", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/manifest.webmanifest", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/catalog/*", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } }
  ],
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer",
    "X-Robots-Tag": "noindex, nofollow"
  }
}
